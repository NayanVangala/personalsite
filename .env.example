# Copy to .env.local and fill in. Never commit .env.local.

# GitHub (server-side only, never exposed to the client).
# Classic PAT with `read:user`, or a fine-grained PAT with public repo read access.
# Add `repo` scope ONLY if you want private contribution counts included.
GITHUB_TOKEN=
# Auto-detected by `npm run refresh:github` via `gh api user --jq .login` if left empty.
GITHUB_USERNAME=

# Contact form (free form service stub). TODO: create a free endpoint at https://formspree.io
# or https://web3forms.com and paste the URL / access key here.
NEXT_PUBLIC_FORM_ENDPOINT=

# Canonical site URL (used for OG tags, sitemap, structured data).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
